rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'technologyvarah@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.createdAt is timestamp;
    }

    function isValidCategory(cat) {
      return cat is string && cat.size() >= 1 && cat.size() <= 50 && (
        cat == 'customer' ||
        cat == 'supplier' ||
        cat == 'stock' ||
        cat == 'purchase' ||
        cat == 'sale' ||
        cat == 'quotation' ||
        cat == 'installation' ||
        cat == 'service' ||
        cat == 'equipment' ||
        cat == 'amc' ||
        cat == 'payment' ||
        cat == 'expense' ||
        cat == 'staff' ||
        cat == 'attendance' ||
        cat == 'notification' ||
        cat == 'permission' ||
        cat == 'cash_bank' ||
        cat == 'work_report'
      );
    }

    function isValidErpItem(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'category', 'code', 'title', 'subtitle', 'partyName',
          'mobile', 'location', 'gstin', 'status', 'priority', 'quantity',
          'minQuantity', 'rate', 'amount', 'paidAmount', 'taxAmount',
          'discountAmount', 'dateStr', 'endDateStr', 'assignedTo', 'notes',
          'tags', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'category', 'code', 'title', 'subtitle', 'partyName',
          'mobile', 'location', 'gstin', 'status', 'priority', 'quantity',
          'minQuantity', 'rate', 'amount', 'paidAmount', 'taxAmount',
          'discountAmount', 'dateStr', 'endDateStr', 'assignedTo', 'notes',
          'tags', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidCategory(data.category)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.subtitle is string && data.subtitle.size() <= 300
        && data.partyName is string && data.partyName.size() <= 200
        && data.mobile is string && data.mobile.size() <= 30
        && data.location is string && data.location.size() <= 500
        && data.gstin is string && data.gstin.size() <= 30
        && data.status is string && data.status.size() >= 1 && data.status.size() <= 50
        && data.priority is string && data.priority.size() >= 1 && data.priority.size() <= 30
        && data.quantity is number && data.quantity >= 0 && data.quantity <= 1000000
        && data.minQuantity is number && data.minQuantity >= 0 && data.minQuantity <= 1000000
        && data.rate is number && data.rate >= 0 && data.rate <= 100000000
        && data.amount is number && data.amount >= 0 && data.amount <= 100000000
        && data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= 100000000
        && data.taxAmount is number && data.taxAmount >= 0 && data.taxAmount <= 100000000
        && data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= 100000000
        && data.dateStr is string && data.dateStr.size() >= 1 && data.dateStr.size() <= 40
        && data.endDateStr is string && data.endDateStr.size() <= 40
        && data.assignedTo is string && data.assignedTo.size() <= 200
        && data.notes is string && data.notes.size() <= 2000
        && data.tags is list && data.tags.size() <= 10
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection 1: Trusted Admins Registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(adminId)
        && isValidAdminRecord(incoming())
        && incoming().uid == adminId
        && incoming().createdAt == request.time
        && isBootstrappedAdmin();
      allow update: if false;
      allow delete: if isVerified() && isValidId(adminId) && isBootstrappedAdmin();
    }

    // Collection 2: Unified CCTV ERP Items
    match /erp_items/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isVerified()
        && isValidId(itemId)
        && isValidErpItem(incoming())
        && incoming().id == itemId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(itemId)
        && isValidErpItem(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().category == existing().category
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().status != 'Closed' || isAdmin())
        && (
          isAdmin() ||
          // Action 1: Status / Workflow Progression
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'assignedTo', 'notes', 'tags', 'updatedAt']) ||
          // Action 2: Financial / Stock / General Record Edit
          incoming().diff(existing()).affectedKeys().hasOnly([
            'code', 'title', 'subtitle', 'partyName', 'mobile', 'location', 'gstin',
            'status', 'priority', 'quantity', 'minQuantity', 'rate', 'amount',
            'paidAmount', 'taxAmount', 'discountAmount', 'dateStr', 'endDateStr',
            'assignedTo', 'notes', 'tags', 'updatedAt'
          ])
        );

      allow delete: if isVerified()
        && isValidId(itemId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
